# Copia este archivo a .env y completa los valores (Supabase > Project Settings > API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave service_role: SOLO en el servidor, nunca en la app
SUPABASE_SERVICE_KEY=
# Solo si tu proyecto usa el secreto JWT legado (HS256). Si usa llaves asimétricas, déjalo vacío.
SUPABASE_JWT_SECRET=

CONF_THRESHOLD=0.6
MARGIN_THRESHOLD=0.15
MAX_UPLOAD_MB=5
CORS_ORIGINS=*
TORCH_THREADS=2
